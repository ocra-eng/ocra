# Copy to apps/members/.env (gitignored).
# Everything here ships in the browser bundle — never put a secret in it.

# Supabase → Connect, or https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…).
# Older projects call this the "anon" key; VITE_SUPABASE_ANON_KEY also works.
# NEVER use the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local API. dev-api.ocra.ie / api.ocra.ie in deployed environments.
VITE_API_URL=http://localhost:4000

# Base URL used to build the QR verification link. Defaults to the current
# origin, which is right for local and both deployed environments.
# VITE_PUBLIC_URL=
