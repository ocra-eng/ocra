{
  "name": "@ocra/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dist": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@ocra/shared": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.10",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "stripe": "^18.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
