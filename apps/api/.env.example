# Copy to .env (gitignored) and fill in. The API refuses to boot if any
# required value is missing — see src/config.ts.

# Supabase → Connect → "Session pooler". Must be the pooler host, not the
# direct db.<ref>.supabase.co one: that is IPv6-only and unreachable from
# hosts without IPv6 egress (Render free tier included).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# https://<project-ref>.supabase.co — used to fetch the JWKS for token checks
SUPABASE_URL=https://<project-ref>.supabase.co

# Stripe: use test keys locally, restricted keys in CI
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the dashboard endpoint in production
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ATHLETE_PRICE_ID=price_...
# Optional until organisational membership launches
STRIPE_ORGANISATION_PRICE_ID=

# Where Stripe returns members after checkout
MEMBERS_APP_URL=http://localhost:5174
# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5174

# Partner discounts for active members, as a JSON array. Served only by
# GET /me/offers to an active member — never put these in a client bundle.
# Fields: key (kebab-case, also names the logo in the members app),
# name, percent, shopUrl (https), code (omit when the shopUrl carries it).
# Empty or unset means no offers. Malformed refuses to boot.
PARTNER_OFFERS=[{"key":"example-shop","name":"Example Shop","percent":10,"shopUrl":"https://example.com","code":"EXAMPLE10"}]

PORT=4000
# local | dev | production — production makes missing Stripe config fatal
APP_ENV=local
